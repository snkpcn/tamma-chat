# ตำมา-ชาติ OS — required environment variables (names only, no secret values here)

# Supabase project (create a NEW, isolated Supabase project for this app —
# never reuse an existing project such as tamma-chat / snk-life-os / Thongthai)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser bundle. Used only in server
# actions / route handlers that require elevated privileges (if any).
SUPABASE_SERVICE_ROLE_KEY=
