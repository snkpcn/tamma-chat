  "extra_triggers": [
    {
      "name": "investment_payments_refresh_actual_v1",
      "table": "investment_payments",
      "schema": "tamma_chart_os",
      "definition": "CREATE TRIGGER investment_payments_refresh_actual_v1 AFTER INSERT OR DELETE OR UPDATE ON tamma_chart_os.investment_payments FOR EACH ROW EXECUTE FUNCTION tamma_chart_os.refresh_investment_actual_from_payment_v1()",
      "function_definition": "CREATE OR REPLACE FUNCTION tamma_chart_os.refresh_investment_actual_from_payment_v1()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'tamma_chart_os', 'pg_temp'\nAS $function$\nbegin\n  if tg_op = 'DELETE' then\n    perform tamma_chart_os.recalculate_investment_actual_v1(old.investment_id);\n    return old;\n  elsif tg_op = 'UPDATE' then\n    perform tamma_chart_os.recalculate_investment_actual_v1(old.investment_id);\n    if new.investment_id <> old.investment_id then\n      perform tamma_chart_os.recalculate_investment_actual_v1(new.investment_id);\n    end if;\n    return new;\n  else\n    perform tamma_chart_os.recalculate_investment_actual_v1(new.investment_id);\n    return new;\n  end if;\nend;\n$function$\n"
    },
    {
      "name": "set_updated_at",
      "table": "investment_payments",
      "schema": "tamma_chart_os",
      "definition": "CREATE TRIGGER set_updated_at BEFORE UPDATE ON tamma_chart_os.investment_payments FOR EACH ROW EXECUTE FUNCTION tamma_chart_os.set_updated_at()",
      "function_definition": "CREATE OR REPLACE FUNCTION tamma_chart_os.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_temp'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
    },
