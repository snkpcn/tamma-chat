  "triggers": [
    {
      "name": "set_updated_at",
      "table": "investment_receipt_intakes",
      "schema": "tamma_chart_os",
      "definition": "CREATE TRIGGER set_updated_at BEFORE UPDATE ON tamma_chart_os.investment_receipt_intakes FOR EACH ROW EXECUTE FUNCTION tamma_chart_os.set_updated_at()",
      "function_definition": "CREATE OR REPLACE FUNCTION tamma_chart_os.set_updated_at()\n RETURNS trigger\n LANGUAGE plpgsql\n SET search_path TO 'pg_temp'\nAS $function$\nbegin\n  new.updated_at = now();\n  return new;\nend;\n$function$\n"
    }
  ],
  "functions": [
    {
      "acl": [
        "=X/supabase_auth_admin",
        "supabase_auth_admin=X/supabase_auth_admin",
        "dashboard_user=X/supabase_auth_admin"
      ],
      "name": "uid",
      "schema": "auth",
      "definition": "CREATE OR REPLACE FUNCTION auth.uid()\n RETURNS uuid\n LANGUAGE sql\n STABLE\nAS $function$\n  select \n  coalesce(\n    nullif(current_setting('request.jwt.claim.sub', true), ''),\n    (nullif(current_setting('request.jwt.claims', true), '')::jsonb ->> 'sub')\n  )::uuid\n$function$\n"
    },
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "auth_restaurant_id",
      "schema": "tamma_chart_os",
      "definition": "CREATE OR REPLACE FUNCTION tamma_chart_os.auth_restaurant_id()\n RETURNS uuid\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'tamma_chart_os', 'pg_temp'\nAS $function$\n  select restaurant_id from tamma_chart_os.profiles where id = auth.uid();\n$function$\n"
    },
    {
      "acl": [
        "postgres=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "recalculate_investment_actual_v1",
      "schema": "tamma_chart_os",
      "definition": "CREATE OR REPLACE FUNCTION tamma_chart_os.recalculate_investment_actual_v1(p_investment_id uuid)\n RETURNS void\n LANGUAGE sql\n SECURITY DEFINER\n SET search_path TO 'tamma_chart_os', 'pg_temp'\nAS $function$\n  update tamma_chart_os.investments i\n  set actual_amount = i.manual_actual_amount + coalesce((\n    select sum(p.amount)\n    from tamma_chart_os.investment_payments p\n    where p.investment_id = i.id\n  ), 0)\n  where i.id = p_investment_id;\n$function$\n"
    }
  ],
