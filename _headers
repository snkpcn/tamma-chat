# WW-12 Global Scale: cache only fingerprint-stable visual assets.
# HTML, CSS and mutable locale/product scripts must revalidate together so a
# fresh document can never be composed with an older responsive layout.
/assets/brand/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/chess/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/thongthai/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/styles/*
  Cache-Control: no-cache, max-age=0, must-revalidate
