# WW-12 Global Scale: cache only static visual/style assets.
# HTML and mutable locale/product scripts above remain revalidated/no-cache.
/assets/brand/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/chess/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/thongthai/*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=604800

/assets/styles/*
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400

