GEMINI_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# WW-12 optional read replica. Leave blank to keep all reads on primary.
SUPABASE_READ_URL=
SUPABASE_READ_SERVICE_ROLE_KEY=
WEATHER_API_KEY=
TAMMA_WEATHER_LAT=
TAMMA_WEATHER_LON=

# WW-0 Worldwide Foundation Lock.
# Missing/0 means OFF. A capability also requires TAMMA_WW_ENABLED=1.
TAMMA_WW_ENABLED=0
TAMMA_WW_DATA_CORE_ENABLED=0
TAMMA_WW_ADDRESS_V2_ENABLED=0
TAMMA_WW_STOREFRONT_ENABLED=0
TAMMA_WW_MULTI_CURRENCY_ENABLED=0
TAMMA_WW_GLOBAL_PAYMENTS_ENABLED=0
TAMMA_WW_GLOBAL_SHIPPING_ENABLED=0
TAMMA_WW_CUSTOMS_ENABLED=0
TAMMA_WW_CHECKOUT_ENABLED=0
TAMMA_WW_FULFILLMENT_ENABLED=0
TAMMA_WW_THONGTHAI_ENABLED=0

# WW-12 structured global scale DB traces. Missing/0 logs only slow/error/fallback requests.
TAMMA_WW_OBSERVABILITY_ENABLED=0

# Shared LINE ingress forwards only configured personal groups to the existing SNK runtime.
SNK_OS_PRIVATE_WEBHOOK_URL=https://snk-life-os-final-stable2.vercel.app/api/line/snk-money
# Omitted/1 preserves the existing bridge. Set 0 to stop every personal probe/dispatch.
SNK_OS_PRIVATE_TRANSPORT_ENABLED=1
# Private runtime configuration only: comma-separated SHA-256(trim(lowercase(group/room ID))).
# Never commit actual hashes. Required in disconnected mode to preserve safe NEW
# business-group binding; missing/invalid data consumes all unbound group commands.
# Existing bound business groups and direct customer messages are unaffected.
SNK_OS_RETIRED_GROUP_HASHES=

