GEMINI_API_KEY=
OPENAI_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# WW-12 optional read replica. Leave blank to keep all reads on primary.
SUPABASE_READ_URL=
SUPABASE_READ_SERVICE_ROLE_KEY=
WEATHER_API_KEY=
TAMMA_WEATHER_LAT=
TAMMA_WEATHER_LON=

# WW-0 Worldwide Foundation Lock.
# Missing/0 means OFF. A capability also requires TAMMA_WW_ENABLED=1.
TAMMA_WW_ENABLED=0
TAMMA_WW_DATA_CORE_ENABLED=0
TAMMA_WW_ADDRESS_V2_ENABLED=0
TAMMA_WW_STOREFRONT_ENABLED=0
TAMMA_WW_MULTI_CURRENCY_ENABLED=0
TAMMA_WW_GLOBAL_PAYMENTS_ENABLED=0
TAMMA_WW_GLOBAL_SHIPPING_ENABLED=0
TAMMA_WW_CUSTOMS_ENABLED=0
TAMMA_WW_CHECKOUT_ENABLED=0
TAMMA_WW_FULFILLMENT_ENABLED=0
TAMMA_WW_THONGTHAI_ENABLED=0

# WW-12 structured global scale DB traces. Missing/0 logs only slow/error/fallback requests.
TAMMA_WW_OBSERVABILITY_ENABLED=0

# SNK MONEY x THONGTHAI -- private personal-finance + daily-coach LINE group (default OFF; fails closed).
# The ledger lives in the SNK LIFE OS Supabase project (snk-life-os-private), NOT the Thongthai one (never falls back to SUPABASE_*).
#
# REQUIRED to enable the feature (Netlify site tamma-chat -> Site configuration -> Environment variables, secret, scope Functions):
SNK_OS_SERVICE_ROLE_KEY=
# Flip to 1 ONLY after both repos are deployed and the checks in docs/SNK_MONEY_HANDOFF.md pass:
SNK_MONEY_ENABLED=0
#
# OPTIONAL (defaults are safe):
#   SNK_OS_SUPABASE_URL      defaults to the snk-life-os-private project URL baked into the code (public, not a secret)
#   SNK_MONEY_OWNER_ID       normally UNSET: the owner is resolved from the group binding, which only a one-time code minted by the
#                            signed-in owner in SNK LIFE OS (Money page) can create.  If set it must be the Supabase *auth user UUID*
#                            (auth.users.id = profiles.id), never a LINE id.
#   PF_OWNER_LINE_USER_IDS   LINE *userId* values (U...), never a groupId; only used together with SNK_MONEY_OWNER_ID
#   PF_FINANCE_MEMBER_LINE_USER_IDS  LINE userIds allowed to record expenses/income (not set balances)
SNK_OS_SUPABASE_URL=
SNK_MONEY_OWNER_ID=
PF_OWNER_LINE_USER_IDS=
PF_FINANCE_MEMBER_LINE_USER_IDS=
