# Copy to .env.local. Keep the real key on this machine only.
OPENAI_API_KEY=

# KKU IntelSphere preview (npm run preview:chat:kku).
KKU_API_KEY=
# These exact model IDs were listed by KKU /api/v1/models on 2026-10-18.
THONGTHAI_SEMANTIC_MODEL=gpt-5.6-terra
THONGTHAI_SEMANTIC_REVIEW_MODEL=gpt-5.6-terra

# To compare with production, set the same model IDs configured on Netlify.
# Leave these commented to use the defaults already defined in the app.
# THONGTHAI_SEMANTIC_MODEL=
# THONGTHAI_SEMANTIC_REVIEW_MODEL=

# Enable the staged visitor paraphrase interpreter (preview enables by default).
# Set the same variable in deployment configuration when releasing this feature.
THONGTHAI_VISITOR_UNDERSTANDING=1

# Optional public-web fallback. This is a search key, separate from KKU.
# Never put keys in index.html or browser code.
THONGTHAI_VISITOR_WEB_SEARCH=1
TAVILY_API_KEY=
# Basic search reserves >= USD 0.008 in the same 2-THB conversation budget.
# Increase if your actual per-request price is higher; cannot lower the floor.
# THONGTHAI_WEB_SEARCH_COST_USD=0.008
